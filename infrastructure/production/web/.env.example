APP_REVISION=unknown
NODE_ENV=production
NEXT_PUBLIC_WEB_URL=https://akademate.com
NEXT_PUBLIC_SITE_URL=https://akademate.com
NEXT_PUBLIC_TENANT_URL=https://admin.akademate.com
TENANT_URL=https://admin.akademate.com
PAYLOAD_CMS_URL=http://localhost:3003
PAYLOAD_API_KEY=

# Public social profiles only. Leave empty to hide the icon. Never use search URLs.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Academy workspace. Marketing /login health-checks this URL and falls back to demo if it is not 2xx/3xx.
APP_LOGIN_URL=https://app.akademate.com/auth/login
NEXT_PUBLIC_APP_LOGIN_URL=https://app.akademate.com/auth/login

# Publish real identity values to hide the amber legal draft banner. Do not invent them.
AKADEMATE_LEGAL_REGISTRY_CODE=
AKADEMATE_LEGAL_VAT_ID=
AKADEMATE_LEGAL_REGISTERED_OFFICE=
AKADEMATE_LEGAL_OPERATING_ADDRESS=
AKADEMATE_LEGAL_PRIVACY_CONTACT=
# Set to true only after documentary validation if the banner must be removed before every field is filled.
AKADEMATE_LEGAL_HIDE_DRAFT_BANNER=

# Server-only contact relay. Never prefix these with NEXT_PUBLIC_.
CONTACT_MAILER_URL=
CONTACT_MAILER_TOKEN=
