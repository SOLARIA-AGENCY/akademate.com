# Task A release and technical smoke contract.
# The token file must contain only the token and must be mode 0600.
HEALTH_TECHNICAL_SMOKE_TOKEN_FILE=/opt/akademate/secrets/health-technical-smoke-token
HEALTH_TECHNICAL_SMOKE_PRINCIPAL=technical-release-smoke:akademate-prod

# Task C authentication contract. CURRENT is mandatory and must be identical
# for the current and candidate containers. PREVIOUS is set only during rotation.
SESSION_SIGNING_SECRET_CURRENT=
SESSION_SIGNING_SECRET_PREVIOUS=
TRUST_PROXY_HEADERS=false
IMPERSONATION_ENABLED=false
ALLOW_DEV_AUTO_LOGIN=false

# A production release must point at a recent verified backup manifest.
RELEASE_BACKUP_MANIFEST=/opt/akademate/backups/latest/manifest.json
BACKUP_CRITICAL_TABLES=users,media
BACKUP_RETENTION_DAYS=14
