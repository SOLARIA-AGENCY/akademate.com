AKADEMATE_NEXT_ENV=local
AKADEMATE_NEXT_IMAGE_TAG=local
AKADEMATE_NEXT_REVISION=local-uncommitted
AKADEMATE_NEXT_DB_NAME=akademate_next
AKADEMATE_NEXT_DB_OWNER_USER=akademate_next_owner
AKADEMATE_NEXT_DB_OWNER_PASSWORD=local_next_owner_password_change_me
AKADEMATE_NEXT_DB_APP_USER=akademate_next_app
AKADEMATE_NEXT_DB_APP_PASSWORD=local_next_app_password_change_me
AKADEMATE_NEXT_REDIS_PASSWORD=local_next_redis_password
AKADEMATE_NEXT_PAYLOAD_SECRET=local_next_payload_secret_change_me_32_chars
AKADEMATE_NEXT_AUTH_SECRET=local_next_auth_secret_change_me_32_chars
AKADEMATE_NEXT_TENANT_PORT=3109
AKADEMATE_NEXT_CAMPUS_PORT=3105
AKADEMATE_NEXT_TENANT_URL=http://localhost:3109
AKADEMATE_NEXT_CAMPUS_URL=http://localhost:3105
AKADEMATE_NEXT_STORAGE_BUCKET=akademate-next-local-media

# Public offer conversion remains fail-closed until every required value is
# supplied through the deployment secret store. Never commit provider values.
AKADEMATE_NEXT_OFFERS_ENABLED=false
AKADEMATE_NEXT_PUBLIC_OFFERS_ENABLED=false
AKADEMATE_NEXT_PUBLIC_SUBMISSIONS_ENABLED=false
AKADEMATE_NEXT_PAID_OFFERS_ENABLED=false
AKADEMATE_NEXT_PUBLIC_PRIVACY_NOTICE_URL=
AKADEMATE_NEXT_PUBLIC_PRIVACY_NOTICE_VERSION=
AKADEMATE_NEXT_PUBLIC_SUBMISSION_PEPPER=
AKADEMATE_NEXT_STRIPE_SECRET_KEY=
AKADEMATE_NEXT_STRIPE_WEBHOOK_SECRET=
AKADEMATE_NEXT_PAYPAL_ENVIRONMENT=
AKADEMATE_NEXT_PAYPAL_CLIENT_ID=
AKADEMATE_NEXT_PAYPAL_CLIENT_SECRET=
AKADEMATE_NEXT_PAYPAL_WEBHOOK_ID=
