# Authentication secrets. Generate independent values with: openssl rand -base64 48
PAYLOAD_SECRET=
SESSION_SIGNING_SECRET_CURRENT=
# During rotation only: retain the former CURRENT value until all v2 cookies have expired.
SESSION_SIGNING_SECRET_PREVIOUS=

# Impersonation is fail-closed unless explicitly enabled.
IMPERSONATION_ENABLED=false

# Development login is available only with NODE_ENV=development and this explicit flag.
ALLOW_DEV_AUTO_LOGIN=false
PAYLOAD_SUPERADMIN_EMAIL=
PAYLOAD_SUPERADMIN_PASSWORD=

# Production cookies require HTTPS.
ENFORCE_HTTPS=true

# Trust x-forwarded-for/x-forwarded-host only behind a configured trusted proxy.
TRUST_PROXY_HEADERS=false
