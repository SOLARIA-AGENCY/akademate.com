{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "app/api/next/course-runs/[id]/offer/route.ts",
    "app/api/next/offer-submissions/route.ts",
    "app/api/next/offer-submissions/[id]/decision/route.ts",
    "app/api/next/offer-submissions/[id]/reviews/route.ts",
    "app/api/next/offer-submissions/[id]/enrollment/route.ts",
    "app/api/next/enrollments/[id]/cancel/route.ts",
    "app/api/next/enrollments/[id]/route.ts",
    "app/api/next/session/route.ts",
    "app/(app)/(dashboard)/cursos/solicitudes/**/*.tsx",
    "app/(app)/(dashboard)/cursos/convocatorias/[id]/oferta/page.tsx",
    "app/(app)/(dashboard)/cursos/convocatorias/[id]/oferta/OfferConfigurationPage.tsx",
    "app/(app)/(dashboard)/matriculas/[id]/EnrollmentCancellationPanel.tsx",
    "app/(next-public)/layout.tsx",
    "app/(next-public)/o/[slug]/**/*.tsx",
    "app/api/next/public/offers/[slug]/route.ts",
    "app/api/next/public/offers/[slug]/submissions/route.ts",
    "app/api/next/public/offers/[slug]/checkout/route.ts",
    "app/api/next/public/payments/webhooks/stripe/route.ts",
    "app/api/next/public/payments/webhooks/paypal/route.ts",
    "app/api/next/public/payments/paypal/return/route.ts",
    "src/lib/offers/**/*.ts",
    "src/lib/payments/**/*.ts",
    "src/lib/enrollments/**/*.ts",
    "src/lib/learning/next-learning-auth.ts",
    "src/lib/learning/next-learning-transaction.ts"
  ],
  "exclude": ["node_modules"]
}
